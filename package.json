{
  "name": "softprobe-js",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' --if-present test",
    "typecheck": "pnpm -r --filter './packages/*' --if-present typecheck",
    "lint": "pnpm -r --filter './packages/*' --if-present lint"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
