{
  "name": "@softprobe/e2e",
  "version": "0.2.8",
  "description": "Full-stack E2E testing SDK pairing e2e browser replay with W3C distributed trace verification across Softprobe Blackbox and Arex",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "softprobe-compile-session": "dist/bin/compile-session.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "default": "./dist/playwright.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "default": "./dist/mobile.js"
    },
    "./session-compiler": {
      "types": "./dist/session-compiler.d.ts",
      "import": "./dist/session-compiler.js",
      "default": "./dist/session-compiler.js"
    },
    "./bin/compile-session.js": {
      "types": "./dist/bin/compile-session.d.ts",
      "import": "./dist/bin/compile-session.js",
      "default": "./dist/bin/compile-session.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "@e2e-dev/mobile": "0.12.8",
    "@e2e-dev/web": "0.16.1",
    "@softprobe/tracing": "*",
    "e2e": "0.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "softprobe",
    "e2e",
    "opentelemetry",
    "tracing",
    "blackbox",
    "arex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softprobe/softprobe-js.git",
    "directory": "packages/e2e"
  },
  "license": "MIT"
}
